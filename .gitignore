```
# Android build outputs
*.apk
*.aar
*.dex

# Android build directories
build/
.externalNativeBuild/
.intermediates/
.profile/

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.properties

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA artifacts
*.iml
*.ipr
*.iws
.idea/

# Temporary files
*.tmp
*.temp

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
coverage/
*.gcov
*.lcov
*.profdata

# Python-related (if any Python scripts exist in the project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Node.js (if any web components exist)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled binary files
*.class
*.o
*.so
*.dll
*.exe
*.out

# OS generated files
.DS_Store
Thumbs.db
```